# Routing engine. Behind an AI SDK provider seam (lib/llm/provider.ts) so this can
# be swapped for a CHOP-approved endpoint without touching the traversal loop.
ANTHROPIC_API_KEY=

# Optional overrides.
# Reasoning: labeling, decision-table compilation, and forks the table defers.
PATHWAY_MODEL=claude-opus-5
# Fast: per-question fact extraction. Benchmarked with `npm run factbench`.
PATHWAY_FAST_MODEL=claude-haiku-4-5-20251001
PATHWAY_DATA_DIR=./data
